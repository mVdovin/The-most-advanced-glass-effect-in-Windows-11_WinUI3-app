<Window
    x:Class="RefactorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <!-- Контейнер с верхним отступом 1010px, чтобы меню из 6 блоков свободно раскрывалось вверх -->
        <Grid x:Name="ContentHostGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,1010,50,50">

            <!-- Невидимый слой-приемник для аппаратной тени DropShadow -->
            <Grid x:Name="DragRegionGrid" Background="Transparent" />

            <!-- Видимая рамка панели с поддержкой перетаскивания мышью -->
            <Border x:Name="TargetBorder"
                    Background="Transparent"
                    BorderBrush="#9F767676"
                    BorderThickness="1.0"
                    CornerRadius="34"
                    Width="350"
                    Height="350"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    PointerPressed="TargetBorder_PointerPressed"
                    PointerMoved="TargetBorder_PointerMoved"
                    PointerReleased="TargetBorder_PointerReleased"
                    PointerCanceled="TargetBorder_PointerReleased">

                <Border.ContextFlyout>
                    <Flyout x:Name="SettingsFlyout" Placement="Top" Opened="Flyout_Opened" Closed="Flyout_Closed">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="BorderBrush" Value="#3E3E42"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="8,6,12,0"/>
                                <Setter Property="MaxHeight" Value="480"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <!-- Фирменная зелёная цветовая схема элементов управления -->
                        <StackPanel Width="265" Spacing="2" RequestedTheme="Dark">
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#00A819"/>
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#00C81E"/>
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#008F15"/>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#00A819"/>
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#00C81E"/>
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#008F15"/>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="#555558"/>

                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#00A819"/>
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#00C81E"/>
                                <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#00A819"/>
                                <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#000000"/>
                            </StackPanel.Resources>

                            <!-- ========================================================= -->
                            <!-- БЛОК 1: НАЛАШТУВАННЯ ВІКНА                                -->
                            <!-- ========================================================= -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="НАЛАШТУВАННЯ ВІКНА"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="White"/>
                                <Button Content="✕"
                                        Click="CloseAppButton_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Foreground="#AAAAAA"
                                        BorderThickness="0"
                                        FontSize="11"
                                        Width="24" Height="24" Padding="0"/>
                            </Grid>

                            <!-- Ширина вікна -->
                            <TextBlock Text="Ширина вікна:" FontSize="12" Foreground="#DCDCDC" Margin="0,0,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="WidthSlider" Minimum="60" Maximum="1000" Value="350" StepFrequency="1"
                                        ValueChanged="ObjectSettings_Changed"/>
                                <TextBlock x:Name="WidthValueText" Grid.Column="1" Text="350"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Висота вікна -->
                            <TextBlock Text="Висота вікна:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HeightSlider" Minimum="40" Maximum="800" Value="350" StepFrequency="1"
                                        ValueChanged="ObjectSettings_Changed"/>
                                <TextBlock x:Name="HeightValueText" Grid.Column="1" Text="350"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Закруглення кутів -->
                            <TextBlock Text="Закруглення кутів:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="175" Value="8" StepFrequency="1"
                                        ValueChanged="ObjectSettings_Changed"/>
                                <TextBlock x:Name="RadiusValueText" Grid.Column="1" Text="34"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Форма вікна -->
                            <TextBlock Text="Форма вікна:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,2">
                                <RadioButton x:Name="SquareRadio" Content="Квадрат" GroupName="ShapeGroup"
                                             IsChecked="True" MinWidth="0" FontSize="13"
                                             Checked="ShapeRadio_Checked"/>
                                <RadioButton x:Name="CircleRadio" Content="Круг" GroupName="ShapeGroup"
                                             MinWidth="0" FontSize="13"
                                             Checked="ShapeRadio_Checked"/>
                            </StackPanel>

                            <!-- ========================================================= -->
                            <!-- БЛОК 2: НАЛАШТУВАННЯ ШЕЙДЕРА                              -->
                            <!-- ========================================================= -->
                            <MenuFlyoutSeparator Margin="0,2,0,2"/>
                            <TextBlock Text="НАЛАШТУВАННЯ ШЕЙДЕРА"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,0,0,2"/>

                            <!-- Ширина краю (EdgeWidth) -->
                            <TextBlock Text="Ширина краю (EdgeWidth):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="EdgeWidthSlider" Minimum="0" Maximum="15" Value="4.0" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="EdgeWidthValueText" Grid.Column="1" Text="4.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Спотворення (Distortion) -->
                            <TextBlock Text="Спотворення (Distortion):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DistortionSlider" Minimum="0" Maximum="3" Value="1.0" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="DistortionValueText" Grid.Column="1" Text="1.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Опуклість / впуклість лінзи -->
                            <TextBlock Text="Опуклість / впуклість лінзи:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="LensCurveSlider" Minimum="-1" Maximum="1" Value="0.00" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="LensCurveValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Зсув RGB (RGBShift) -->
                            <TextBlock Text="Зсув RGB (RGBShift):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RgbShiftSlider" Minimum="0" Maximum="0.1" Value="0.010" StepFrequency="0.001"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="RgbShiftValueText" Grid.Column="1" Text="0.010"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Інтенсивність розмиття -->
                            <TextBlock Text="Інтенсивність розмиття:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BlurIntensitySlider" Minimum="0" Maximum="30" Value="0" StepFrequency="0.5"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="BlurIntensityValueText" Grid.Column="1" Text="0"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- БЛОК 3: НАЛАШТУВАННЯ ТІНІ                                 -->
                            <!-- ========================================================= -->
                            <MenuFlyoutSeparator Margin="0,2,0,2"/>
                            <TextBlock Text="НАЛАШТУВАННЯ ТІНІ"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,0,0,2"/>

                            <!-- Розмиття тіні (BlurRadius) -->
                            <TextBlock Text="Розмиття тіні (BlurRadius):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="30" Value="6" StepFrequency="0.5"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="ShadowBlurValueText" Grid.Column="1" Text="6"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Зсув тіні (ShadowDepth) -->
                            <TextBlock Text="Зсув тіні (ShadowDepth):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="10" Value="1.4" StepFrequency="0.1"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="ShadowDepthValueText" Grid.Column="1" Text="1.4"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Прозорість тіні (Opacity) -->
                            <TextBlock Text="Прозорість тіні (Opacity):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" Value="0.41" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="ShadowOpacityValueText" Grid.Column="1" Text="0.41"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- БЛОК 4: ОКАНТОВКА ТА СВІТІННЯ                            -->
                            <!-- ========================================================= -->
                            <MenuFlyoutSeparator Margin="0,2,0,2"/>
                            <TextBlock Text="ОКАНТОВКА ТА СВІТІННЯ"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,0,0,2"/>

                            <!-- Товщина окантовки -->
                            <TextBlock Text="Товщина окантовки:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="6" Value="1.0" StepFrequency="0.5"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="BorderThicknessValueText" Grid.Column="1" Text="1.0"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Інтенсивність світіння -->
                            <TextBlock Text="Інтенсивність світіння:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderGlowSlider" Minimum="0" Maximum="2" Value="0.0" StepFrequency="0.05"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="BorderGlowValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Колір світіння (Білий -> Чорний) -->
                            <TextBlock Text="Колір світіння (Білий → Чорний):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderGlowColorSlider" Minimum="0" Maximum="1" Value="0.00" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="BorderGlowColorValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- БЛОК 5: ГРАДІЄНТ ПОВЕРХ ВІКНА                             -->
                            <!-- ========================================================= -->
                            <MenuFlyoutSeparator Margin="0,2,0,2"/>
                            <TextBlock Text="ГРАДІЄНТ ПОВЕРХ ВІКНА"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,0,0,2"/>

                            <!-- Кут градієнта -->
                            <TextBlock Text="Кут градієнта (°):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GradientAngleSlider" Minimum="0" Maximum="360" Value="250" StepFrequency="1"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="GradientAngleValueText" Grid.Column="1" Text="250"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Інтенсивність градієнта -->
                            <TextBlock Text="Інтенсивність градієнта:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GradientIntensitySlider" Minimum="0" Maximum="1" Value="0.0" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="GradientIntensityValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Колір градієнта (Білий -> Чорний) -->
                            <TextBlock Text="Колір градієнта (Білий → Чорний):" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GradientColorSlider" Minimum="0" Maximum="1" Value="0.00" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="GradientColorValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- БЛОК 6: ТЕКСТУРА ТА МІКРОСПОТВОРЕННЯ                     -->
                            <!-- ========================================================= -->
                            <MenuFlyoutSeparator Margin="0,2,0,2"/>
                            <TextBlock Text="ТЕКСТУРА ТА МІКРОСПОТВОРЕННЯ"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="White"
                                       Margin="0,0,0,2"/>

                            <!-- Щільність спотворень -->
                            <TextBlock Text="Щільність спотворень:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TextureDensitySlider" Minimum="0" Maximum="1" Value="0.0" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="TextureDensityValueText" Grid.Column="1" Text="0.00"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>

                            <!-- Яскравість спотворень -->
                            <TextBlock Text="Яскравість спотворень:" FontSize="12" Foreground="#DCDCDC" Margin="0,-2,0,-8"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="TextureBrightnessSlider" Minimum="0" Maximum="1" Value="0.40" StepFrequency="0.01"
                                        ValueChanged="ShaderSettings_Changed"/>
                                <TextBlock x:Name="TextureBrightnessValueText" Grid.Column="1" Text="0.40"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="13" Foreground="White"/>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Border.ContextFlyout>

                <!-- Аппаратная поверхность DirectX -->
                <SwapChainPanel x:Name="TargetPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Window>